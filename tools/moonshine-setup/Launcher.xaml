<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moonshine" Width="880" Height="735" MinWidth="760" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#101820" Foreground="#EDF4EB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#26352F"/><Setter Property="Foreground" Value="#F0F5EE"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D1DFCF"/><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="22,10"/><Setter Property="Background" Value="#203129"/><Setter Property="Foreground" Value="#D1DFCF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,5,0"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#B8EB79"/><Setter Property="Foreground" Value="#14221D"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><Image x:Name="BrandImage" Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Moonshine" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="1.0 RC2 · Vos jeux, depuis Moonlight" FontSize="13" Foreground="#A5B9A1"/></StackPanel></DockPanel>
    <TabControl x:Name="MainTabs" Grid.Row="1" Background="#101820" BorderThickness="0" Padding="0,18,0,0">
      <TabItem Header="Accueil"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#EDF4EB"><StackPanel>
        <Border Background="#1B2A22" CornerRadius="12" Padding="22" Margin="0,0,0,20"><StackPanel><TextBlock x:Name="StatusText" Text="Vérification de Moonshine…" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="Un instant, nous préparons votre prochaine étape." Foreground="#BDCFB8" FontSize="14" Margin="0,10,0,0"/></StackPanel></Border>
        <UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="#17231E" Padding="15" Margin="0,0,8,0" CornerRadius="8"><StackPanel><TextBlock Text="01  INSTALLATION" Foreground="#94AB8D" FontSize="11"/><TextBlock x:Name="InstallStep" Text="À faire" FontSize="17" Margin="0,7,0,0"/></StackPanel></Border><Border Background="#17231E" Padding="15" Margin="0,0,8,0" CornerRadius="8"><StackPanel><TextBlock Text="02  PILOTES" Foreground="#94AB8D" FontSize="11"/><TextBlock x:Name="DriverStep" Text="À vérifier" FontSize="17" Margin="0,7,0,0"/></StackPanel></Border><Border Background="#17231E" Padding="15" CornerRadius="8"><StackPanel><TextBlock Text="03  SERVICE" Foreground="#94AB8D" FontSize="11"/><TextBlock x:Name="RunStep" Text="Arrêté" FontSize="17" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
        <StackPanel x:Name="InstallChoices" Margin="0,0,0,16"><CheckBox x:Name="AutomaticChoice" Content="Démarrer le service avec Windows" IsChecked="True"/><CheckBox x:Name="MigrateChoice" Content="Reprendre le catalogue et l’appairage de mon ancien service 0.9"/><TextBlock Text="L’icône de gestion démarre avec votre session Windows. Les lanceurs Xbox, EA et Steam restent nécessaires pour leurs jeux." FontSize="12" Foreground="#A5B9A1" Margin="0,6,0,0"/></StackPanel>
        <WrapPanel><Button x:Name="PrimaryButton" Content="Patientez…" Background="#B8EB79" Foreground="#14221D" FontWeight="SemiBold" FontSize="16" Padding="24,14"/><Button x:Name="StopButton" Content="Arrêter le service"/></WrapPanel>
        <ProgressBar x:Name="OperationProgress" Height="5" Minimum="0" Maximum="100" Value="0" Background="#223329" Foreground="#B8EB79" BorderThickness="0" Margin="0,8,0,10"/><TextBlock x:Name="OperationText" Text="Les opérations système demandent la confirmation Windows." FontSize="12" Foreground="#A5B9A1"/>
        <TextBlock Text="Une fois installé, utilisez l’icône près de l’horloge. Fermer cette fenêtre laisse le service fonctionner." Foreground="#A5B9A1" FontSize="12" Margin="0,18,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Entretien"><ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#EDF4EB"><StackPanel>
        <TextBlock Text="Gardez Moonshine en bon état" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Terminez le stream et arrêtez le service avant une sauvegarde, une réparation ou un retrait." Foreground="#BDCFB8" Margin="0,0,0,20"/>
        <WrapPanel><Button x:Name="RepairButton" Content="Réparer / mettre à jour"/><Button x:Name="DriversButton" Content="Vérifier les pilotes signés"/></WrapPanel>
        <WrapPanel><Button x:Name="BackupButton" Content="Sauvegarder"/><Button x:Name="DiagnosticButton" Content="Exporter un diagnostic"/><Button x:Name="HelpButton" Content="Guide"/></WrapPanel>
        <Border Background="#1B2A22" Padding="18" CornerRadius="10" Margin="0,15,0,20"><TextBlock Text="Les sauvegardes privées conservent les réglages, l’appairage et la bibliothèque. La réparation utilise le paquet vérifié de cette version." Foreground="#BDCFB8"/></Border>
        <Button x:Name="RemoveButton" Content="Désinstaller Moonshine" HorizontalAlignment="Left" Background="#492B2D"/><TextBlock Text="Le service, l’icône et l’inscription Windows seront retirés. Le programme sera archivé; la bibliothèque et les pilotes partagés seront conservés." Foreground="#B7B9AD" FontSize="12"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="Moonshine · Fork de VibeShine / Sunshine" FontSize="11" Foreground="#718B75" DockPanel.Dock="Left"/><Button x:Name="TrayButton" Content="Revenir à l’icône" Padding="12,6" FontSize="12" Margin="0" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
