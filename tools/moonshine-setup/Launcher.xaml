<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moonshine" Width="790" Height="660" MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#101827" Foreground="#EEF3FC" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#26354D"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DFE8F8"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="FontSize" Value="14"/></Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MOONSHINE" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="1.0 RC1 · Bibliothèque PC et service Windows" FontSize="16" Foreground="#A9C8FF" Margin="0,5,0,20"/></StackPanel>
    <Border Grid.Row="1" Background="#19263B" CornerRadius="10" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="StatusText" Text="Vérification de l’installation…" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="Installez Moonshine, préparez les pilotes au besoin, puis ouvrez la bibliothèque." Foreground="#C6D3E6" Margin="0,8,0,0"/></StackPanel></Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,15"><CheckBox x:Name="MigrateChoice" Content="Reprendre le catalogue et l’appairage de mon service 0.9"/><CheckBox x:Name="AutomaticChoice" Content="Démarrer Moonshine avec Windows" IsChecked="True"/><TextBlock Text="Une installation neuve fonctionne sans ancienne version. Les lanceurs Xbox, EA ou Steam restent nécessaires pour leurs jeux." Foreground="#9EB0C8" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="3"><WrapPanel><Button x:Name="InstallButton" Content="Installer / mettre à jour" Background="#3767CE"/><Button x:Name="DriversButton" Content="Préparer les pilotes signés"/></WrapPanel><WrapPanel><Button x:Name="StartButton" Content="Démarrer"/><Button x:Name="StopButton" Content="Arrêter"/><Button x:Name="OpenButton" Content="Ouvrir la bibliothèque"/></WrapPanel></StackPanel>
    <TextBlock Grid.Row="4" Text="Les opérations système demandent la confirmation Windows. La synchronisation utilise votre compte normal. Les copies de récupération restent sur ce PC." Foreground="#9EB0C8" FontSize="13" Margin="0,14,0,0"/>
    <DockPanel Grid.Row="5"><Button x:Name="RemoveButton" Content="Retirer le service" DockPanel.Dock="Left"/><Button x:Name="HelpButton" Content="Guide" DockPanel.Dock="Right"/></DockPanel>
  </Grid>
</Window>
