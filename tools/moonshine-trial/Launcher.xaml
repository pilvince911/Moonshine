<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Moonshine · Essai Windows" Width="790" Height="610" MinWidth="720" MinHeight="570" WindowStartupLocation="CenterScreen"
    Background="#101814" Foreground="#EDF5EC" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#25382D"/><Setter Property="Foreground" Value="#EDF5EC"/>
      <Setter Property="BorderBrush" Value="#47634E"/><Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Border Padding="30">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="MOONSHINE" FontSize="13" FontWeight="SemiBold" Foreground="#B8EB79"/>
        <TextBlock Text="Votre bibliothèque. Votre stream." FontSize="28" FontWeight="SemiBold" Margin="0,9,0,5"/>
        <TextBlock Text="Essai autonome · Xbox PC, Steam et EA" Foreground="#B4C4B8"/>
      </StackPanel>
      <Border Grid.Row="1" Background="#1B2A21" BorderBrush="#39523F" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,20">
        <StackPanel>
          <TextBlock Text="Un espace d’essai séparé" FontWeight="SemiBold" Foreground="#C8EFAB"/>
          <TextBlock Text="Le catalogue, les identifiants et la synchronisation de cet essai restent dans son propre dossier Windows. Vos anciennes fiches ne sont pas reprises ici." Margin="0,6,0,0" Foreground="#BFCBC2"/>
          <TextBlock Text="Avant de démarrer : terminez votre stream et arrêtez temporairement VibeShine dans Services. Vous le relancerez après les essais." Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2">
        <WrapPanel>
          <Button x:Name="StartButton" Content="Démarrer l’essai" Background="#B8EB79" Foreground="#14221D" BorderBrush="#B8EB79" FontWeight="SemiBold"/>
          <Button x:Name="OpenButton" Content="Ouvrir la bibliothèque" IsEnabled="False"/>
          <Button x:Name="StopButton" Content="Arrêter l’essai" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Text="Prêt à préparer votre essai." Margin="0,5,0,10" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailText" Text="Les fichiers sont vérifiés et réparés depuis le paquet avant chaque démarrage." Foreground="#B4C4B8"/>
        <Border Height="1" Background="#2E4034" Margin="0,18,0,16"/>
        <TextBlock Text="Préparer et retrouver vos fichiers" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel>
          <Button x:Name="BackupButton" Content="Sauvegarder VibeShine…"/>
          <Button x:Name="FilesButton" Content="Dossier de l’essai"/>
          <Button x:Name="ServicesButton" Content="Ouvrir Services"/>
        </WrapPanel>
        <TextBlock x:Name="FolderText" Foreground="#91A99A" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </StackPanel>
      <TextBlock Grid.Row="3" Text="0.8.1 · version de développement · moteur VibeShine / Sunshine · client Moonlight" FontSize="12" Foreground="#7F9888" Margin="0,15,0,0"/>
    </Grid>
  </Border>
</Window>
